{
  "name": "@cpm/controller",
  "version": "3.6.1",
  "description": "Caddy Proxy Manager controller - the web UI and REST API",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vinext dev",
    "demo": "bun scripts/demo.ts",
    "build": "vinext build && bun scripts/inject-runtime-guard.mjs",
    "build:binary": "bun build --compile --target=${BUN_COMPILE_TARGET:-bun} --outfile dist/standalone/cpm-server scripts/standalone-entry.ts",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "bun scripts/with-test-db.ts bun test --parallel tests/unit tests/integration",
    "test:sqlite": "TEST_DB=sqlite bun scripts/with-test-db.ts bun test --parallel tests/unit tests/integration",
    "test:watch": "bun scripts/with-test-db.ts bun test --watch tests/unit tests/integration",
    "test:upgrade": "bun scripts/with-test-db.ts bun tests/upgrade/run.ts",
    "test:upgrade:agent": "bun tests/upgrade/mixed-agent.ts",
    "test:coverage": "bun scripts/with-test-db.ts bun test --isolate --coverage tests/unit tests/integration && bun scripts/coverage-ratchet.ts",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test:e2e:ui": "playwright test --ui --config tests/playwright.config.ts",
    "test:e2e:headed": "playwright test --headed --config tests/playwright.config.ts",
    "test:e2e:no-clickhouse": "playwright test --config tests/playwright.no-clickhouse.config.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.5",
    "@astryxdesign/theme-neutral": "^0.6.5",
    "@better-auth/passkey": "1.7.7",
    "@better-auth/utils": "0.5.0",
    "@clickhouse/client": "^1.23.1",
    "@cpm/shared": "workspace:*",
    "apexcharts": "^7.8.0",
    "better-auth": "^1.7.7",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.3",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.24.1",
    "jose": "^6.2.12",
    "ldapts": "^9.2.0",
    "lucide-react": "^1.50.0",
    "maplibre-gl": "^6.11.2",
    "maxmind": "^5.0.7",
    "next": "^16.3.8",
    "next-intl": "^4.14.9",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.0.13",
    "react": "^19.3.0",
    "react-apexcharts": "^2.1.1",
    "react-dom": "^19.3.0",
    "react-map-gl": "^8.1.3",
    "react-server-dom-webpack": "^19.3.0",
    "sonner": "^2.0.8",
    "swagger-ui-react": "5.33.1",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "uqr": "0.1.3",
    "web-push": "^3.6.7",
    "world-atlas": "^2.0.2",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@better-auth/core": "^1.7.7",
    "@eloqnt/cli": "^0.6.33",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui-react": "5.18.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@types/web-push": "^3.6.4",
    "@types/yargs": "^17.0.35",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "bcryptjs": "^3.0.3",
    "drizzle-kit": "^0.31.11",
    "vinext": "^1.0.1",
    "vite": "^8.3.2"
  }
}
