{
  "denyDefault": [
    {
      "handler": "subroute",
      "routes": [
        {
          "match": [
            {
              "client_ip": {
                "ranges": ["10.9.0.0/16"]
              },
              "not": [
                {
                  "client_ip": {
                    "ranges": ["10.0.0.0/8"]
                  }
                }
              ]
            }
          ],
          "handle": [
            {
              "handler": "static_response",
              "status_code": 403,
              "body": "Access denied"
            }
          ]
        },
        {
