# Compose variables for the end-to-end stack. Passed with `--env-file`, which replaces the
# repo-root .env rather than adding to it -- so a developer's local .env cannot change what the
# suite runs, and a machine without one (CI) behaves identically.
#
# These two exist only so interpolation succeeds. docker-compose.yml declares both with
# `:?ERROR - ... is required`, which aborts before any container starts if they are unset.
# Neither value reaches a service under test: tests/docker-compose.test.yml overrides
# SESSION_SECRET and CLICKHOUSE_PASSWORD per service with its own literals.
#
# Analytics is switched off for the no-clickhouse suite by ANALYTICS_ENABLED=false in its playwright
# config -- not by blanking the password here, and not by the profile: the agent starts ClickHouse
# whenever web says analytics is on.
SESSION_SECRET=e2e-interpolation-placeholder-32chars
# Unlike the two placeholders above, this one IS what the stack runs with: every web
# container reaches the postgres service with it, and no per-service override replaces it.
POSTGRES_PASSWORD=e2e-postgres-password
CLICKHOUSE_PASSWORD=e2e-interpolation-placeholder
