{
  "interactiveLogin": false,
  "httpServer": "NettyWrapper",
  "tokenCallbacks": [
    {
      "issuerId": "default",
      "requestMappings": [
        {
          "requestParam": "grant_type",
          "match": "authorization_code",
          "claims": {
            "sub": "evil-oauth-user",
            "email": "evil@idp.example",
            "email_verified": true,
            "name": "Evil OAuth User",
            "role": "admin"
          }
        }
      ]
    },
    {
      "issuerId": "groups-prefixed",
      "requestMappings": [
        {
          "requestParam": "grant_type",
          "match": "authorization_code",
          "claims": {
            "sub": "groups-prefixed-user",
            "email": "groups-prefixed@idp.example",
            "email_verified": true,
            "name": "Groups Prefixed User",
            "groups": ["/Org/cpm-Operator", "cpm-Team Alpha", "unrelated"]
          }
        }
      ]
    },
    {
      "issuerId": "groups-unmatched",
      "requestMappings": [
        {
          "requestParam": "grant_type",
          "match": "authorization_code",
          "claims": {
            "sub": "groups-unmatched-user",
            "email": "groups-unmatched@idp.example",
            "email_verified": true,
            "name": "Groups Unmatched User",
            "roles": { "cpm": ["Team Beta"] }
          }
        }
      ]
    },
    {
      "issuerId": "linker-a",
      "requestMappings": [
        {
          "requestParam": "grant_type",
          "match": "authorization_code",
          "claims": {
            "sub": "linker-sub-a",
            "email": "testadmin@localhost",
            "email_verified": true,
            "name": "Test Admin"
          }
        }
      ]
    },
    {
      "issuerId": "linker-b",
      "requestMappings": [
        {
          "requestParam": "grant_type",
          "match": "authorization_code",
          "claims": {
            "sub": "linker-sub-b",
            "email": "testadmin@localhost",
            "email_verified": true,
            "name": "Test Admin"
          }
        }
      ]
    },
    {
      "issuerId": "linker-c",
      "requestMappings": [
        {
          "requestParam": "grant_type",
          "match": "authorization_code",
          "claims": {
            "sub": "linker-sub-c",
            "email": "testadmin@localhost",
            "email_verified": true,
            "name": "Test Admin"
          }
        }
      ]
    }
  ]
}
