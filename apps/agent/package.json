{
  "name": "@cpm/agent",
  "version": "3.7.4",
  "description": "Caddy Proxy Manager agent - manages the Caddy container on its host",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build:binary": "bun build --compile --target=${BUN_COMPILE_TARGET:-bun} --outfile dist/cpm-agent src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel tests"
  },
  "dependencies": {
    "@cpm/shared": "workspace:*",
    "maxmind": "^5.0.7",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.35"
  }
}
