---
/**
 * The frame around a live demo.
 *
 * The demo itself is a React island in the default slot - the controller's own component, running,
 * not a screenshot of it. This wrapper is deliberately dumb: it names what is on screen, says that
 * it is real, and draws a border so a dark form does not bleed into a dark page. Everything about
 * how the component looks belongs to Astryx, and is set up in DemoSurface and demo.css.
 */
interface Props {
  /** What the reader is looking at, in the product's own words. */
  title: string;
  /** Optional line telling the reader what to try, or what is stubbed out. */
  note?: string;
}

const { title, note } = Astro.props;

/**
 * Astro has no `useId`, and the badge and its tooltip have to agree on one. This markup is
 * rendered once at build time and never hydrated, so a random id is stable in the output and
 * cannot collide with the second demo on a page - which a title slug could.
 */
const hintID = `cpm-demo-hint-${crypto.randomUUID().slice(0, 8)}`;
---

<figure class="cpm-demo-frame not-content">
  <figcaption>
    <strong>{title}</strong>
    {note && <span>{note}</span>}
    {/* A button, so the tooltip is reachable without a pointer, and described-by rather than
        labelled-by so a screen reader reads the badge and then the caveat. */}
    <button type="button" class="cpm-demo-badge" aria-describedby={hintID}>Demo</button>
    <span class="cpm-demo-hint" id={hintID} role="tooltip">Nothing you change here is saved</span>
  </figcaption>
  <slot />
</figure>

<script>
  /*
   * Takes the app's own links back out of the demos.
   *
   * The components in here are the product's, so they link where they link in the product:
   * `/analytics` on the overview's traffic card, `#` on the stat cards beside it. Those are the
   * dashboard's routes, and this is not the dashboard - following one leaves the documentation
   * site for a URL that does not exist. Links with a scheme are left alone, because those go
   * somewhere real and are part of what the component is showing: the Caddy Build demo lists every
   * plugin it can compile in, each linked to its repository, and that is worth keeping. So are the
   * links under `data-cpm-demo-routes`, whose demo serves those routes itself (the setup flow).
   *
   * React does most of it: next/link and every Astryx link render through DemoLink, which leaves
   * the href out on the server and in the browser alike. This catches a plain anchor that does not,
   * and only once its island has hydrated - changing the server's markup first is what made every
   * delinked anchor a hydration mismatch. Until then a click on one goes nowhere.
   *
   * Dropping `href` rather than swallowing the click is what makes it stop being a link - no
   * pointer cursor, no status bar preview, and not announced as one. The `tabindex` goes with it,
   * or a keyboard would still stop on a card that no longer does anything.
   */
  const HAS_SCHEME = /^[a-z][a-z0-9+.-]*:/i;

  function isDeadLink(anchor: HTMLAnchorElement): boolean {
    const href = anchor.getAttribute("href");
    if (href !== null && HAS_SCHEME.test(href)) return false;
    return !anchor.closest("[data-cpm-demo-routes]");
  }

  function deLink(root: ParentNode) {
    const anchors = root.querySelectorAll<HTMLAnchorElement>("a[href]");
    for (const anchor of anchors) {
      if (!isDeadLink(anchor) || anchor.closest("astro-island[ssr]")) continue;
      anchor.removeAttribute("href");
      // Assigned, not removed: React sets tabIndex as a property, which survives the attribute
      // going away. Writing it back is what the observer watches for.
      if (anchor.tabIndex !== -1) anchor.tabIndex = -1;
      anchor.dataset.cpmDemoDelinked = "";
    }
  }

  for (const frame of document.querySelectorAll(".cpm-demo-frame")) {
    frame.addEventListener(
      "click",
      (event) => {
        const anchor = (event.target as Element | null)?.closest?.("a[href]");
        if (anchor instanceof HTMLAnchorElement && isDeadLink(anchor)) event.preventDefault();
      },
      true,
    );
    deLink(frame);
    // `ssr` leaves an island once it has hydrated, which is when its anchors are React's.
    new MutationObserver(() => deLink(frame)).observe(frame, {
      attributeFilter: ["href", "tabindex", "ssr"],
      childList: true,
      subtree: true,
    });
  }
</script>
