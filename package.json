{
  "name": "caddy-proxy-manager",
  "version": "3.7.5",
  "description": "Web UI for managing Caddy reverse proxies",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "contributors": [
    "fuomag9 <1580624+fuomag9@users.noreply.github.com>",
    "SilentSpud <1478389+SilentSpud@users.noreply.github.com>"
  ],
  "devEngines": {
    "runtime": {
      "name": "bun",
      "onFail": "error"
    },
    "packageManager": {
      "name": "bun",
      "onFail": "error"
    }
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "astryx": {
    "theme": "neutral"
  },
  "scripts": {
    "dev": "bun run --filter @cpm/controller dev",
    "build": "bun run --filter @cpm/controller build",
    "build:binary": "bun run --filter @cpm/controller build:binary",
    "start": "bun run --filter @cpm/controller start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "typecheck": "bun run --filter @cpm/shared typecheck && bun run --filter @cpm/agent typecheck && bun run --filter @cpm/controller typecheck && bun run --filter @cpm/site typecheck",
    "test:all": "./scripts/test-all.sh",
    "db:generate": "bun run --filter @cpm/controller db:generate",
    "db:migrate": "bun run --filter @cpm/controller db:migrate",
    "test": "bun run --filter @cpm/agent test && bun run --filter @cpm/controller test",
    "demo": "bun apps/controller/scripts/demo.ts",
    "test:sqlite": "bun run --filter @cpm/controller test:sqlite",
    "test:watch": "bun run --filter @cpm/controller test:watch",
    "test:coverage": "bun run --filter @cpm/agent test && bun run --filter @cpm/controller test:coverage",
    "test:e2e": "bun run --filter @cpm/controller test:e2e",
    "test:e2e:ui": "bun run --filter @cpm/controller test:e2e:ui",
    "test:e2e:headed": "bun run --filter @cpm/controller test:e2e:headed",
    "test:e2e:no-clickhouse": "bun run --filter @cpm/controller test:e2e:no-clickhouse"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@socketsecurity/bun-security-scanner": "^1.1.3",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@astrojs/starlight": "0.42.5",
    "@esbuild-kit/esm-loader": "file:./patches/esbuild-kit-esm-loader-stub",
    "@graphql-tools/utils": "^12.0.3",
    "fflate": "^0.7.5",
    "http-cache-semantics": "^4.3.0",
    "postcss-selector-parser": "^7.1.6",
    "source-map-js": "^1.2.2"
  },
  "trustedDependencies": [
    "@astryxdesign/core",
    "@tree-sitter-grammars/tree-sitter-yaml",
    "core-js-pure"
  ],
  "patchedDependencies": {
    "vinext@1.0.1": "patches/vinext@1.0.1.patch"
  }
}
