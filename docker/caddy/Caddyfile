{
	# Compose points CADDY_ADMIN_LISTEN at the internal caddy-admin network, off caddy-network where
	# every upstream could reach it; unset, only an unpublished 2019 bounds the open bind.
	# `origins` stops a page in the operator's browser reconfiguring the proxy; on a named bind it is
	# also enforced against Host, which Caddy skips on an open interface.
	admin {$CADDY_ADMIN_LISTEN:0.0.0.0:2019} {
		origins caddy-admin:2019 caddy:2019 localhost:2019 localhost
	}
}

# Placeholder until CPM's first apply replaces this wholesale; HTTP only, so a fresh install cannot
# fail a certificate order before anything is configured.
http://{$DASHBOARD_DOMAIN:caddyproxymanager.com}, http://localhost {
	respond "Caddy Proxy Manager is running - configure proxy hosts via the web interface" 200
}
